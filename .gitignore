# --- Python / virtual environments ---
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
env/

# --- Tooling caches ---
.pytest_cache/
.ruff_cache/
.mypy_cache/
.ipynb_checkpoints/
.coverage
htmlcov/

# --- Secrets (HF tokens, Kaggle API keys, etc. must never be committed) ---
.env
.env.*
*.token
*.key
*.pem
kaggle.json
hf_token*
credentials*.json
secrets*.json

# --- Model weights and caches (never in git) ---
*.safetensors
*.bin
*.pt
*.pth
*.ckpt
*.gguf
*.onnx
hf_cache/
.cache/
models_cache/

# --- Generated data: ignored by default ---
# Only the directory README is tracked. A frozen dataset release
# (docs/05_DATASET_SPECIFICATION.md) is added deliberately at its release tag
# with `git add -f <file>` after a licence check (REQ-ENV-09).
data/*
!data/README.md

# --- Experimental results: ignored by default ---
# Large artifacts (hidden states) live outside git and are referenced by SHA-256
# in run manifests (docs/03_SYSTEM_ARCHITECTURE.md §6). Small result files needed
# for the submission are added deliberately with `git add -f`.
# Ignore other generated results
results/*
!results/README.md
# Include RQ1 research results
!results/rq1_qwen/
!results/rq1_llama/
!results/rq1_comparison/

# Include all files inside RQ1 folders
!results/rq1_qwen/**
!results/rq1_llama/**
!results/rq1_comparison/**

*.npy
*.npz
*.h5
*.hdf5
*.zip

# --- Course material without redistribution permission ---
# The professor's project specification is kept locally only (see references/README.md).
references/*.docx
references/*.pdf

# --- OS / editors ---
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/

# Exclude duplicate result formats from GitHub
results/**/*.pdf
results/**/*.xlsx

results/rq1_llama/config/extraction_checkpoint.json
results/rq1_llama/probes/*_progress.json

#zip files are generated by the evaluation script and are not needed in the repo
results/rq1_llama/probes/*.zip
results.zip